# Public Constructive devnet endpoints. Supply credentials through the runner's secret store.
CONSTRUCTIVE_DEVNET_AUTH_ENDPOINT=https://auth.launchql.dev/graphql
CONSTRUCTIVE_DEVNET_API_ENDPOINT=https://api.launchql.dev/graphql
CONSTRUCTIVE_DEVNET_MODULES_ENDPOINT=https://modules.launchql.dev/graphql
CONSTRUCTIVE_DEVNET_AGENT_ENDPOINT=https://agent.launchql.dev/graphql
CONSTRUCTIVE_DEVNET_COMPUTE_ENDPOINT=https://compute.launchql.dev/graphql

# For a specific app, supply exact URLs from its trusted tenant descriptor.
# CONSTRUCTIVE_DEVNET_TENANT_AUTH_ENDPOINT=
# CONSTRUCTIVE_DEVNET_TENANT_DATA_ENDPOINT=

# Secret inputs for the relevant realm: CONSTRUCTIVE_DEVNET_PLATFORM_TOKEN or
# CONSTRUCTIVE_DEVNET_TENANT_TOKEN. Keep their values out of this profile.
