    },
    {
      "$type": "RelationBelongsTo",
      "source_table": "session_people",
      "target_table": "sessions",
      "field_name": "session_id",
      "delete_action": "c",
      "is_required": true
    },
    {
      "$type": "RelationBelongsTo",
      "source_table": "session_people",
