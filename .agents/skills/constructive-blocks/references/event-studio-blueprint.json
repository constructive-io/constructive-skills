          },
          "privileges": ["select", "insert", "update"]
        },
        {
          "$type": "AuthzEntityMembership",
          "policy_name": "admin_delete",
          "data": {
            "entity_field": "org_id",
            "membership_type": 2,
            "is_admin": true
          },
          "privileges": ["delete"]
