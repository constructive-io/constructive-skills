      "$type": "RelationBelongsTo",
      "source_table": "sessions",
      "target_table": "programs",
      "field_name": "program_id",
      "delete_action": "r",
      "is_required": false
    },
    {
      "$type": "RelationBelongsTo",
      "source_table": "sessions",
      "target_table": "venues",
      "field_name": "venue_id",
